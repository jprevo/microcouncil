{
  "name": "microcouncil",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jprevo/microcouncil/issues"
  },
  "homepage": "https://microcouncil.me",
  "description": "Générateur de prompt pour un micro-conseil de compagnons.",
  "keywords": [
    "prompt",
    "prompting",
    "experts",
    "council",
    "ai",
    "llm",
    "chatgpt",
    "gemini",
    "claude",
    "deepseek",
    "mistral"
  ],
  "author": "Jonathan Prévost <microcouncil.nemesis515@passmail.net>",
  "scripts": {
    "pages": "node scripts/build-pages.mjs",
    "og": "node scripts/build-og.mjs",
    "predev": "npm run pages && npm run og",
    "dev": "vite",
    "prebuild": "npm run pages && npm run og",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "pregate": "npm run pages",
    "gate": "node scripts/gate.mjs",
    "skill": "node scripts/build-skill.mjs",
    "emoji": "node scripts/build-emoji.mjs",
    "shuffle": "node scripts/shuffle-members.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
